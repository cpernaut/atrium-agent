# Copy to .env (local) or paste into the app's Secrets on Streamlit Cloud.

# --- required ---
OPENAI_API_KEY=sk-...
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# --- optional: LangSmith tracing ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_PROJECT=Atrium Agent
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com   # only if your workspace is EU
